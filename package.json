{
  "name": "evo-microservice-api",
  "version": "0.0.1",
  "description": "EVO Microservice API - A NestJS microservices system with CQRS + Event Sourcing",
  "author": "EVO Development Team",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "bun@1.1.38",
  "scripts": {
    "format": "bunx prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "bunx prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "bunx eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "bunx eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "lint:check": "bunx eslint . --ext .ts,.tsx,.js,.jsx --max-warnings 0",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:cov": "bunx jest --coverage",
    "test:debug": "bun --inspect-brk test",
    "test:e2e": "bunx jest --config ./test/jest-e2e.json",
    "install:clean": "rm -rf node_modules bun.lockb && bun install",
    "typecheck": "bunx tsc --noEmit",
    "typecheck:watch": "bunx tsc --noEmit --watch",
    "dev": "bun --watch --hot src/apps/${npm_config_service:-auth}/main.ts",
    "build": "bun build ./src/apps/${npm_config_service:-auth}/main.ts --outdir ./dist/apps/${npm_config_service:-auth} --target bun",
    "start": "bun run dist/apps/${npm_config_service:-auth}/main.js",
    "build:service": "bun build",
    "code:check": "bun run typecheck && bun run lint:check && bun run format:check",
    "code:fix": "bun run lint:fix && bun run format",
    "pre-commit": "bun run code:check && bun run test",
    "prepare": "bunx husky install || true"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.0",
    "kafkajs": "^2.2.4",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bun": "latest",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "bun-types": "latest",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^16.2.6",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@apps/(.*)$": "<rootDir>/apps/$1"
    }
  },
  "type": "module",
  "module": "src/main.ts",
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20.0.0"
  },
  "trustedDependencies": [
    "@nestjs/cli"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "bunx eslint --fix",
      "bunx prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "bunx prettier --write"
    ]
  }
}
